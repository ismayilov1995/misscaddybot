TELEGRAM_BOT_TOKEN=        # From BotFather
BOT_USERNAME=misscaddybot  # Without @

# AI provider: "openai" (default), "anthropic", or "grok"
AI_PROVIDER=openai

# OpenAI (ChatGPT) — used when AI_PROVIDER=openai
OPENAI_API_KEY=            # platform.openai.com/api-keys
# AI_MODEL=gpt-4o-mini    # default; gpt-4o for higher quality

# Anthropic (Claude) — used when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=         # console.anthropic.com
# AI_MODEL=claude-haiku-4-5-20251001  # default; cheapest Claude model

# xAI (Grok) — used when AI_PROVIDER=grok
XAI_API_KEY=               # console.x.ai
# AI_MODEL=grok-3-mini     # default; grok-3 for higher quality

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/misscaddybot
